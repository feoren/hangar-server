# Caddy in front of the Hangar server: TLS (Let's Encrypt/ZeroSSL automatically, TLS 1.2+); WebSocket
# is passed through without extra configuration. The server sets security headers itself
# (including HSTS with an https PUBLIC_URL); Caddy only removes its own identification.
{
	# Email for ACME notices (optional): email admin@example.org
}

{$TEAM_DOMAIN} {
	encode zstd gzip
	header -Server
	# Access logs stay off: paths like /invite/<token> and /auth/magic/<token> carry secrets.
	# If you need access logs, you must mask these paths.
	reverse_proxy server:8080 {
		# Long-lived WebSocket connections; the server pings every 25 s.
		stream_timeout 24h
		stream_close_delay 5s
	}
}
