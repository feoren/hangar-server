# Hangar-Teamserver: Vorlage für .env (nie einchecken). Alle Werte auch als Umgebungsvariablen.

# --- Allgemein ---------------------------------------------------------------------------
# Öffentlicher Ursprung, unter dem Caddy den Server ausliefert (ohne Pfad). Im Selbstbetrieb
# trägt man in Hangar <PUBLIC_URL>/api/v1 als Server ein. Hangar spricht http/ws nur mit
# 127.0.0.1, localhost und [::1]; im LAN oder Netz also https (z. B. Caddy, im LAN `tls internal`).
PUBLIC_URL=https://team.example.org
# Nur für docker-compose.yml (Caddy): der Hostname von PUBLIC_URL.
# Browseraufrufe der Startseite / weiterleiten (308), z. B. auf die Produktseite. Nur https://
# (http:// nur für localhost). Leer = / antwortet mit 404. /health, /v1/live usw. bleiben unberührt.
ROOT_REDIRECT=
TEAM_DOMAIN=team.example.org
BIND_ADDR=0.0.0.0:8080
DATA_DIR=/data
# json (Betrieb) oder pretty (Entwicklung). Feinsteuerung: RUST_LOG=info,sqlx=warn
LOG_FORMAT=json
# Nur true hinter dem eigenen Proxy (Caddy), sonst lassen sich Adressen fälschen.
TRUST_PROXY=false
# Weitere erlaubte Origins für Browseranfragen (kommagetrennt); die App sendet keinen.
ALLOWED_ORIGINS=

# --- Identität ---------------------------------------------------------------------------
# official: Konten/Projekte/Plätze auf hangar.feoren.com, das Relay prüft nur deren Tickets.
# local:    Selbstbetrieb mit eigener Anmeldung, Teams, Einladungen und Lizenzprüfung.
IDENTITY=official

# Öffentliche Ed25519-Schlüssel der Ticket-Aussteller: kid:base64url(32 Byte), kommagetrennt.
# Rotation: neuen Schlüssel ergänzen, bevor er signiert; alten nach 5 Minuten entfernen.
TICKET_PUBLIC_KEYS=
# Pflichtwert für "aud" in jedem Ticket. Leer = hangar-relay bei IDENTITY=official (so stellt
# die Webseite aus, dort TEAM_TICKET_AUDIENCE) bzw. PUBLIC_URL bei IDENTITY=local. Nur ändern,
# wenn die Webseite einen anderen Wert ausstellt.
TICKET_AUDIENCE=

# --- Widerrufsliste der Webseite (nur IDENTITY=official) -----------------------------------
# Ohne REVOCATION_URL wirken entzogene Rechte erst beim nächsten Ticket.
# Beispiel (Pfad legt die Webseite fest): https://hangar.feoren.com/api/v1/team/revocations
REVOCATION_URL=
# Geheimes Bearer-Token des Relays bei der Webseite, mindestens 32 Zeichen.
RELAY_REVOCATION_TOKEN=
REVOCATION_INTERVAL_SECS=15

# --- Live-Verbindung ----------------------------------------------------------------------
# Speicher: jede Verbindung kann einen Rahmen bis 1 MiB puffern. Faustregel 2 MiB je
# Verbindung; 200 passen in das Compose-Limit von 512 MiB (docs/protocol.md, Speicher).
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_MEMBER=8
# Je Client-Adresse (IPv6 je /64); darüber 503 vor dem Upgrade. Hinter einem gemeinsamen
# Firmen-NAT gegebenenfalls erhöhen.
MAX_CONNECTIONS_PER_IP=20
# Höchstalter je Team ab dem letzten geprüften Ticket (hello oder ticket.renew); danach Close
# 4401 und Neuverbindung mit neuem Ticket. 10 min begrenzen Restrisiken, bis ticket.renew wirkt.
CONNECTION_MAX_AGE_SECS=600
RESERVATION_INACTIVITY_SECS=1800
RESERVATION_WARN_SECS=300
BLOB_QUOTA_BYTES=67108864
TRANSCRIPT_RETENTION_DAYS=90

# --- Nur IDENTITY=local ---------------------------------------------------------------------
# Mindestens 32 zufällige Zeichen (CSRF, Ratenbegrenzung). Erzeugen: openssl rand -base64 48
SERVER_SECRET=
# invite: nur bestehende Konten und eingeladene Adressen; open: jede Adresse.
SIGNUP=invite
# Öffentliche Schlüssel der Webseite für Lizenzdokumente: kid:base64url(32 Byte).
LICENSE_PUBLIC_KEYS=
# Widerrufene Lizenz-IDs (lid), kommagetrennt.
LICENSE_REVOKED=
DEFAULT_LANG=en

# Mail: smtp, log (.eml unter DATA_DIR/mail) oder none (Links gehen an den Admin zurück).
MAIL_TRANSPORT=none
MAIL_FROM=Hangar <team@example.org>
SMTP_HOST=
# starttls (Port 587) oder smtps (Port 465); Zertifikate werden immer geprüft.
SMTP_TLS=starttls
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
