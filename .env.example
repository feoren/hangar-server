# Hangar server: template for .env (never commit it). All values also work as environment variables.

# --- General -----------------------------------------------------------------------------
# Public origin under which Caddy serves the server (without a path). When self-hosting, enter
# <PUBLIC_URL>/api/v1 as the server in Hangar. Hangar speaks http/ws only with 127.0.0.1,
# localhost and [::1]; on a LAN or the internet use https (e.g. Caddy, on a LAN `tls internal`).
PUBLIC_URL=https://team.example.org
# Redirect browser requests for the start page / (308), e.g. to the product page. https:// only
# (http:// only for localhost). Empty = / responds with 404. /health, /v1/live etc. are unaffected.
ROOT_REDIRECT=
# Only for docker-compose.yml (Caddy): the host name of PUBLIC_URL.
TEAM_DOMAIN=team.example.org
BIND_ADDR=0.0.0.0:8080
DATA_DIR=/data
# json (production) or pretty (development). Fine-grained control: RUST_LOG=info,sqlx=warn
LOG_FORMAT=json
# Set to true only behind your own proxy (Caddy), otherwise addresses can be spoofed.
TRUST_PROXY=false
# Additional allowed origins for browser requests (comma-separated); the app sends none.
ALLOWED_ORIGINS=

# --- Identity ----------------------------------------------------------------------------
# official: accounts/projects/seats on hangar.feoren.com, the relay only checks their tickets.
# local:    self-hosting with its own sign-in, teams, invitations and license check.
IDENTITY=official

# Public Ed25519 keys of the ticket issuers: kid:base64url(32 bytes), comma-separated.
# Rotation: add the new key before it signs; remove the old one after 5 minutes.
TICKET_PUBLIC_KEYS=
# Required value for "aud" in every ticket. Empty = hangar-relay with IDENTITY=official (this is
# what the website issues, see TEAM_TICKET_AUDIENCE there) or PUBLIC_URL with IDENTITY=local.
# Only change it if the website issues a different value.
TICKET_AUDIENCE=

# --- Revocation list from the website (IDENTITY=official only) ----------------------------
# Without REVOCATION_URL, revoked permissions only take effect with the next ticket.
# Example (the website defines the path): https://hangar.feoren.com/api/v1/team/revocations
REVOCATION_URL=
# Secret bearer token of the relay at the website, at least 32 characters.
RELAY_REVOCATION_TOKEN=
REVOCATION_INTERVAL_SECS=15

# --- Live connection ----------------------------------------------------------------------
# Memory: each connection can buffer a frame of up to 1 MiB. Rule of thumb: 2 MiB per
# connection; 200 fit into the Compose limit of 512 MiB (docs/protocol.md, memory).
MAX_CONNECTIONS=200
MAX_CONNECTIONS_PER_MEMBER=8
# Per client address (IPv6 per /64); above that, 503 before the upgrade. Raise it if needed
# behind a shared corporate NAT.
MAX_CONNECTIONS_PER_IP=20
# Maximum age per team since the last verified ticket (hello or ticket.renew); after that, close
# 4401 and reconnect with a new ticket. 10 min limit residual risks until ticket.renew takes effect.
CONNECTION_MAX_AGE_SECS=600
RESERVATION_INACTIVITY_SECS=1800
RESERVATION_WARN_SECS=300
BLOB_QUOTA_BYTES=67108864
TRANSCRIPT_RETENTION_DAYS=90

# --- IDENTITY=local only --------------------------------------------------------------------
# At least 32 random characters (CSRF, rate limiting). Generate: openssl rand -base64 48
SERVER_SECRET=
# invite: only existing accounts and invited addresses; open: any address.
SIGNUP=invite
# Public keys of the website for license documents: kid:base64url(32 bytes).
LICENSE_PUBLIC_KEYS=
# Revoked license IDs (lid), comma-separated.
LICENSE_REVOKED=
DEFAULT_LANG=en

# Mail: smtp, log (.eml under DATA_DIR/mail) or none (links are returned to the admin).
MAIL_TRANSPORT=none
MAIL_FROM=Hangar <team@example.org>
SMTP_HOST=
# starttls (port 587) or smtps (port 465); certificates are always verified.
SMTP_TLS=starttls
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
